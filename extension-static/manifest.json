{
  "manifest_version": 3,
  "name": "SP Tool 27",
  "version": "1.0.0",
  "description": "Scouty Player 27: open fut.gg players in the FC 27 Transfer Market with Max Buy Now set. Great for FUT Gallery sets. Read-only.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://www.fut.gg/*", "https://www.ea.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.fut.gg/*"],
      "js": ["futgg.js"],
      "css": ["futgg.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.ea.com/*ultimate-team/web-app*"],
      "js": ["panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.ea.com/*ultimate-team/web-app*"],
      "js": ["ea-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*"], "matches": ["https://www.fut.gg/*", "https://www.ea.com/*"] }
  ]
}
